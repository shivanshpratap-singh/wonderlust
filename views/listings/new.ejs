<% layout("/layouts/boilerplate") %>

  <div class="row">
    <div class="col-8 offset-2"></div>
    <h3>Create a New Listing</h3>
    <form method="POST" action="/listings" novalidate class="needs-validation" enctype="multipart/form-data"> 
      <div class="mb-3">
          <lable for="title" class="form-lable">Title</lable>
      <input 
      name="listing[title]" 
      placeholder="enter title" 
      type="text"
      class="form-control"
      required
      />
      <div class="valid-feedback">Title looks good!</div>
      </div>
      
      <div class="mb-3">
         <textarea
        name="listing[description]"
        placeholder="enter description"
        class="form-control"
        required
      ></textarea>
       <div class="invalid-feedback">Please enter the description!/div>
      </div>
      
<div class="mb-3">
        <lable for="Image" class="form-lable">Upload Image</lable>
       <input
        name="listing[image]"
        type="file"
        accept="image/jpeg,image/png"
        class="form-control"
      />
      </div>

      <div class="row col-md-4">
      <div class="mb-3">
          <lable for="title" class="form-lable">Price</lable>
           <input 
           name="listing[price]" 
           placeholder="enter price"
         
             class="form-control"
             required
             />
             <div class="invalid-feedback">Price should be valid!</div>

      </div>

       
      <div class="mb-3 col-md-8">

          <lable for="title" class="form-lable">Country</lable>
              <input name="listing[country]" 
              placeholder="enter country" 
              type="text" 
              class="form-control" 
              required
              />
               <div class="invalid-feedback">Please enter the country name!/div>

      </div>
      </div>
     
      <div class="mb-3">
          <lable for="title" class="form-lable">Location</lable>
            <input
        name="listing[location]"
        placeholder="enter location"
        type="text"
        class="form-control"
      />
       <div class="invalid-feedback">Please enter the location!/div>

      </div>
      
      <button btn btn-dark add-btn>Add</button>
    </form>
  </div>
